{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./client/src/*"] }
  },
  "include": ["client/src/**/*", "netlify/functions/**/*", "tests/**/*", "vite.config.ts"]
}
